{
"dur": 31.215,
"shots": [
{
"i": 1,
"start": 0.0,
"vo_start": 0.6,
"vo_end": 11.139,
"text": "London, November 1875. The British government has a chance to buy a huge stake in the new Suez Canal, the shortcut to India. It needs four million pounds, fast.",
"end": 11.414
},
{
"i": 2,
"start": 11.414,
"vo_start": 11.689,
"vo_end": 17.409,
"text": "Parliament isn't sitting, so it can't vote the money. Prime Minister Disraeli sends his secretary to one man.",
"end": 17.684
},
{
"i": 3,
"start": 17.684,
"vo_start": 17.959,
"vo_end": 23.999,
"text": "Lionel de Rothschild, the story goes, asked one question: 'What is your security?' 'The British government.' 'Then you shall have it.'",
"end": 24.274
},
{
"i": 4,
"start": 24.274,
"vo_start": 24.549,
"vo_end": 30.265,
"text": "One family could lend a superpower four million pounds almost overnight. How did they get there?",
"end": 31.215
}
],
