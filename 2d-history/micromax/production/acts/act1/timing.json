{
"dur": 38.071,
"shots": [
{
"i": 1,
"start": 0.0,
"vo_start": 0.6,
"vo_end": 5.444,
"text": "The story starts with Rahul Sharma, a Delhi boy from a middle-class family who studied engineering.",
"end": 5.719
},
{
"i": 2,
"start": 5.719,
"vo_start": 5.994,
"vo_end": 14.714,
"text": "In the 1990s he asked his father for a computer that cost about 56,000 rupees, a huge amount for a family like his. His father bought it.",
"end": 14.989
},
{
"i": 3,
"start": 14.989,
"vo_start": 15.264,
"vo_end": 21.184,
"text": "With no internet at home, he learned programming from books, then started writing software and supplying computer hardware.",
"end": 21.459
},
{
"i": 4,
"start": 21.459,
"vo_start": 21.734,
"vo_end": 29.054,
"text": "In 2000, he and three friends, Vikas Jain, Rajesh Agarwal and Sumeet Kumar, set up a company called Micromax.",
"end": 29.329
},
{
"i": 5,
"start": 29.329,
"vo_start": 29.604,
"vo_end": 37.121,
"text": "At first Micromax was an IT company, selling software and computer parts. Small, steady, unglamorous.",
"end": 38.071
}
],
