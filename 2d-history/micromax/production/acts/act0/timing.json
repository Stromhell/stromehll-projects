"vo_end": 7.36,
"text": "In 2014, an Indian phone brand outsold Samsung in India for a few months. It was called Micromax.",
"end": 7.635
},
{
"i": 2,
"start": 7.635,
"vo_start": 7.91,
"vo_end": 12.029,
"text": "It had Hugh Jackman in its ads and its name on cricket's Asia Cup.",
"end": 12.304
},
{
"i": 3,
"start": 12.304,
"vo_start": 12.579,
"vo_end": 17.379,
"text": "Five years later, it had lost almost all of its market. Who killed Micromax?",
"end": 18.329
}
