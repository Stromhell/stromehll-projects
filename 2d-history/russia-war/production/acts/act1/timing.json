{
"dur": 43.009,
"shots": [
{
"i": 1,
"start": 0.0,
"vo_start": 0.6,
"vo_end": 10.52,
"text": "In Belgium sits SHAPE, NATO's military headquarters. Its commander, the Supreme Allied Commander Europe, gets the call: Tallinn, Riga and Vilnius are under attack.",
"end": 10.795
},
{
"i": 2,
"start": 10.795,
"vo_start": 11.07,
"vo_end": 19.575,
"text": "Russia's likely plan is called a fait accompli. Grab the land fast, dig in, and dare NATO to start a much bigger war to take it back.",
"end": 19.85
},
{
"i": 3,
"start": 19.85,
"vo_start": 20.125,
"vo_end": 27.227,
"text": "In a famous war game by the RAND think tank, Russian forces reached the Baltic capitals in about 36 to 60 hours.",
"end": 27.502
},
{
"i": 4,
"start": 27.502,
"vo_start": 27.777,
"vo_end": 36.071,
"text": "The three Baltic states are small. Together they have about six million people, and they border Russia or its ally Belarus on almost every land side.",
"end": 36.346
},
{
"i": 5,
"start": 36.346,
"vo_start": 36.621,
"vo_end": 42.059,
"text": "So every hour they hold out matters. Each day of delay gives NATO time to arrive.",
"end": 43.009
}
],
