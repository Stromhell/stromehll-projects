{
"dur": 24.997,
"shots": [
{
"i": 1,
"start": 0.0,
"vo_start": 0.6,
"vo_end": 8.08,
"text": "When Putin flies abroad, reports say four identical planes take off. Only one has him on board. And that is just one of his tricks.",
"end": 8.355
},
{
"i": 2,
"start": 8.355,
"vo_start": 8.63,
"vo_end": 13.547,
"text": "An armoured car that shrugs off grenades. Four identical planes in the sky at once.",
"end": 13.822
},
{
"i": 3,
"start": 13.822,
"vo_start": 14.097,
"vo_end": 19.337,
"text": "A train that is on no timetable, and offices that look the same but sit hundreds of kilometres apart.",
"end": 19.612
},
{
"i": 4,
"start": 19.612,
"vo_start": 19.887,
"vo_end": 24.047,
"text": "Each one tells us something about how Russia works, and about the man at the top.",
"end": 24.997
}
],
