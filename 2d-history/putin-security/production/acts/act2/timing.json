{
"dur": 54.392,
"shots": [
{
"i": 1,
"start": 0.0,
"vo_start": 0.6,
"vo_end": 3.83,
"text": "This is his car, a Russian-built Aurus Senat limousine.",
"end": 4.105
},
{
"i": 2,
"start": 4.105,
"vo_start": 4.38,
"vo_end": 9.738,
"text": "Inside it is all leather, soft seats and a small bar. Outside, it is built like a vault.",
"end": 10.013
},
{
"i": 3,
"start": 10.013,
"vo_start": 10.288,
"vo_end": 15.088,
"text": "Picture an ambush on the road into Moscow. Attackers open fire.",
"end": 15.363
},
{
"i": 4,
"start": 15.363,
"vo_start": 15.638,
"vo_end": 20.176,
"text": "The armour is designed to stop heavy rounds, reportedly even armour-piercing ones.",
"end": 20.451
},
{
"i": 5,
"start": 20.451,
"vo_start": 20.726,
"vo_end": 24.365,
"text": "A grenade lands under the car. It rolls on through the smoke.",
"end": 24.64
},
{
"i": 6,
"start": 24.64,
"vo_start": 24.915,
"vo_end": 30.724,
"text": "The fuel tank is sealed against blasts, and the tyres are built to keep running even after they are shot out.",
"end": 30.999
},
{
"i": 7,
"start": 30.999,
"vo_start": 31.274,
"vo_end": 39.972,
"text": "It weighs around six and a half tonnes, but a twin-turbo V8 with a hybrid system can still push it to around 160 or 170 kilometres an hour, depending on the source.",
"end": 40.247
},
{
"i": 8,
"start": 40.247,
"vo_start": 40.522,
"vo_end": 48.256,
"text": "The cabin can seal itself and filter the air, so a gas attack would struggle to reach the passenger. There is an emergency exit too.",
"end": 48.531
},
{
"i": 9,
"start": 48.531,
"vo_start": 48.806,
"vo_end": 53.442,
"text": "For short trips, the car is his shield. For long ones, he takes to the air.",
"end": 54.392
}
],
