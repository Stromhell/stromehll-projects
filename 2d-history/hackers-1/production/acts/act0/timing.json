"start": 0.0,
"vo_start": 0.6,
"vo_end": 8.121,
"text": "A Twitter employee gets a phone call from the company's help desk. There's a problem with his work login. Could he sign in again, please?",
"end": 8.396
},
{
"i": 2,
"start": 8.396,
"vo_start": 8.671,
"vo_end": 17.231,
"text": "He does. The caller thanks him and hangs up. He isn't the help desk. He's a 17-year-old in Florida with a jewelled Rolex.",
"end": 17.506
},
{
"i": 3,
"start": 17.506,
"vo_start": 17.781,
"vo_end": 26.141,
"text": "Within a day he takes over the Twitter accounts of Obama, Biden, Bill Gates, Jeff Bezos and Elon Musk, and uses them to run a Bitcoin scam.",
"end": 27.091
}
],
