"vo_start": 0.6,
"vo_end": 7.117,
"text": "The scary part is how simple it was. No brilliant code. Just a phone call and a fake web page.",
"end": 7.392
},
{
"i": 2,
"start": 7.392,
"vo_start": 7.667,
"vo_end": 15.547,
"text": "A 17-year-old briefly held the voices of presidents and billionaires. He used them to steal Bitcoin. It could have been much worse.",
"end": 15.822
},
{
"i": 3,
"start": 15.822,
"vo_start": 16.097,
"vo_end": 23.937,
"text": "He wasn't the first teenager to break into giants. In part two: the boys who stole the next Xbox before Microsoft even released it.",
"end": 24.887
}
