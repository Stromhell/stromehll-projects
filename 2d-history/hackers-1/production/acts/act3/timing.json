{
"dur": 47.422,
"shots": [
{
"i": 1,
"start": 0.0,
"vo_start": 0.6,
"vo_end": 8.96,
"text": "July 2020. His new plan: forget hacking stars one by one. Get inside Twitter itself, and take any account he wants.",
"end": 9.235
},
{
"i": 2,
"start": 9.235,
"vo_start": 9.51,
"vo_end": 14.43,
"text": "He tells a few people online that he works at Twitter. A small crew forms on Discord.",
"end": 14.705
},
{
"i": 3,
"start": 14.705,
"vo_start": 14.98,
"vo_end": 23.66,
"text": "Using LinkedIn, he finds Twitter employees and phones them, pretending to be the internal help desk. Most hang up. A few report him.",
"end": 23.935
},
{
"i": 4,
"start": 23.935,
"vo_start": 24.21,
"vo_end": 33.09,
"text": "But one employee believes him, and signs in on a fake login page. Graham uses those details, and the code from the employee's phone, to get onto Twitter's network.",
"end": 33.365
},
{
"i": 5,
"start": 33.365,
"vo_start": 33.64,
"vo_end": 42.042,
"text": "That account can't reach the controls he wants. So he reads through internal messages until he finds login details for someone with far more access.",
"end": 42.317
},
{
"i": 6,
"start": 42.317,
"vo_start": 42.592,
"vo_end": 46.472,
"text": "Now Graham can change the email and password on almost any Twitter account in the world.",
"end": 47.422
}
],
