{
"dur": 30.396,
"shots": [
{
"i": 1,
"start": 0.0,
"vo_start": 0.6,
"vo_end": 5.8,
"text": "That evening, Twitter does something it has never done: it stops verified accounts from tweeting at all.",
"end": 6.075
},
{
"i": 2,
"start": 6.075,
"vo_start": 6.35,
"vo_end": 14.15,
"text": "It kicks every employee off the internal network, one session at a time. Graham is cut off. The hack is over.",
"end": 14.425
},
{
"i": 3,
"start": 14.425,
"vo_start": 14.7,
"vo_end": 21.38,
"text": "The shutdown had side effects. News outlets went quiet, and a US weather service office couldn't tweet a tornado warning.",
"end": 21.655
},
{
"i": 4,
"start": 21.655,
"vo_start": 21.93,
"vo_end": 29.446,
"text": "Graham's take was reported at over 100,000 dollars. Crypto exchanges froze his wallets, which stopped even more money from reaching him.",
"end": 30.396
}
],
