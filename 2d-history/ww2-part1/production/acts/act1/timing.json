{
"dur": 33.893,
"shots": [
{
"i": 1,
"start": 0.0,
"vo_start": 0.6,
"vo_end": 6.439,
"text": "1919. World War One is over, and the winners meet at Versailles, near Paris, to write the peace.",
"end": 6.714
},
{
"i": 2,
"start": 6.714,
"vo_start": 6.989,
"vo_end": 13.429,
"text": "One line, Article 231, put the blame for the war's losses on Germany. Germans called it the war guilt clause.",
"end": 13.704
},
{
"i": 3,
"start": 13.704,
"vo_start": 13.979,
"vo_end": 22.324,
"text": "France and Britain wanted Germany to pay. In 1921 the bill was set at 132 billion gold marks, about 33 billion dollars at the time.",
"end": 22.599
},
{
"i": 4,
"start": 22.599,
"vo_start": 22.874,
"vo_end": 26.513,
"text": "Germany didn't finish paying off the last of those debts until 2010.",
"end": 26.788
},
{
"i": 5,
"start": 26.788,
"vo_start": 27.063,
"vo_end": 32.943,
"text": "The army was cut to 100,000 men. No air force. Almost no navy.",
"end": 33.893
}
],
