{
"dur": 50.692,
"shots": [
{
"i": 1,
"start": 0.0,
"vo_start": 0.6,
"vo_end": 13.828,
"text": "From here the years fly. 1996: Nike signs a young golfer, Tiger Woods. 2003: it buys bankrupt Converse for about 305 million dollars, and signs an 18-year-old LeBron James.",
"end": 14.103
},
{
"i": 2,
"start": 14.103,
"vo_start": 14.378,
"vo_end": 23.698,
"text": "2015: LeBron gets a lifetime deal, reportedly worth over a billion dollars. 2016: Knight's memoir, Shoe Dog, becomes a bestseller.",
"end": 23.973
},
{
"i": 3,
"start": 23.973,
"vo_start": 24.248,
"vo_end": 31.408,
"text": "2017: Vaporfly shoes help runners break records so often that track officials later write new rules about shoe technology.",
"end": 31.683
},
{
"i": 4,
"start": 31.683,
"vo_start": 31.958,
"vo_end": 41.034,
"text": "2018: an anniversary Just Do It ad with Colin Kaepernick. Some customers burned their shoes. Others bought more, and the ad won major awards.",
"end": 41.309
},
{
"i": 5,
"start": 41.309,
"vo_start": 41.584,
"vo_end": 49.742,
"text": "2019: Eliud Kipchoge, in Nike prototypes, runs a marathon distance in under two hours, in a special event that didn't count as an official record.",
"end": 50.692
}
],
