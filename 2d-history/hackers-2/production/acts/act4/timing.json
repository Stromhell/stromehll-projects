{
"i": 1,
"start": 0.0,
"vo_start": 0.6,
"vo_end": 8.92,
"text": "The others can't resist. One by one: Microsoft, EA, Valve, Activision, Blizzard. Then companies far beyond games.",
"end": 9.195
},
{
"i": 2,
"start": 9.195,
"vo_start": 9.47,
"vo_end": 15.756,
"text": "Intel, AMD, Disney, Warner Bros, Google. Around 25 major companies in total.",
"end": 16.031
},
{
"i": 3,
"start": 16.031,
"vo_start": 16.306,
"vo_end": 26.862,
"text": "In 2012 two members find a link from a game studio to a US Army system, and an Apache helicopter simulator being built for the military. They hesitate. Then they download it.",
"end": 27.137
},
{
"i": 4,
"start": 27.137,
"vo_start": 27.412,
"vo_end": 34.692,
"text": "They joke about what they'd call their gang in prison. 'Xbox Underground' sounds cool. They laugh. Not for long.",
"end": 35.642
}
],
