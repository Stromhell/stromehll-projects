"vo_start": 0.6,
"vo_end": 8.8,
"text": "Then an 18-year-old fan offers them a real prototype. He has been sneaking into Microsoft's campus for months, using copied access cards.",
"end": 9.075
},
{
"i": 2,
"start": 9.075,
"vo_start": 9.35,
"vo_end": 14.707,
"text": "One night he walks into an office, puts three prototype consoles in his backpack, and walks out.",
"end": 14.982
},
{
"i": 3,
"start": 14.982,
"vo_start": 15.257,
"vo_end": 22.369,
"text": "A week later Microsoft offers him a job he'd applied for. Weeks after that, security cameras catch up with him, and he loses it.",
"end": 23.319
}
],
