"vo_start": 0.6,
"vo_end": 8.0,
"text": "March 2014. A young Canadian and his dad drive to the US border. He's going to pick up a car bumper from an online friend.",
"end": 8.275
},
{
"i": 2,
"start": 8.275,
"vo_start": 8.55,
"vo_end": 16.19,
"text": "The officer scans his passport. A strange word pops up on the screen. 'Xenomega?' That's his online gaming name.",
"end": 16.465
},
{
"i": 3,
"start": 16.465,
"vo_start": 16.74,
"vo_end": 27.899,
"text": "Officers surround the car. He's arrested. The FBI has been after him for years. He's part of a gang that broke into Microsoft, Epic Games, and even a US Army simulator project.",
"end": 28.849
}
