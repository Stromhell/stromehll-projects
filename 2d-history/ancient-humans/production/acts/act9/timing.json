{
"dur": 45.653,
"shots": [
{
"i": 1,
"start": 0.0,
"vo_start": 0.6,
"vo_end": 3.48,
"text": "And the alarm that woke you this morning is just the latest payment.",
"end": 3.755
},
{
"i": 2,
"start": 3.755,
"vo_start": 4.03,
"vo_end": 12.629,
"text": "For most of human history, finding food took part of the week. Afternoons went to craft, beauty and friendship. Nights went to stories.",
"end": 12.904
},
{
"i": 3,
"start": 12.904,
"vo_start": 13.179,
"vo_end": 16.339,
"text": "You will spend something like ninety thousand hours of your life at work.",
"end": 16.614
},
{
"i": 4,
"start": 16.614,
"vo_start": 16.889,
"vo_end": 21.91,
"text": "We make art if there's anything left after the job. They made it on an ordinary afternoon.",
"end": 22.185
},
{
"i": 5,
"start": 22.185,
"vo_start": 22.46,
"vo_end": 28.34,
"text": "We network to get ahead. They spent hours with the people they loved, and it counted as survival.",
"end": 28.615
},
{
"i": 6,
"start": 28.615,
"vo_start": 28.89,
"vo_end": 32.41,
"text": "We chase a finish line called retirement, where we finally get our time back.",
"end": 32.685
},
{
"i": 7,
"start": 32.685,
"vo_start": 32.96,
"vo_end": 35.04,
"text": "In one way, they were already standing on it.",
"end": 35.315
},
{
"i": 8,
"start": 35.315,
"vo_start": 35.59,
"vo_end": 39.513,
"text": "They woke up without an alarm, and asked the question you rarely get to ask.",
"end": 39.788
},
{
"i": 9,
"start": 39.788,
"vo_start": 40.063,
"vo_end": 44.703,
"text": "If this changed how you see your own day, watch next how farming built the first cities.",
"end": 45.653
}
],
