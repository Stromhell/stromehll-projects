"dur": 44.148,
"shots": [
{
"i": 1,
"start": 0.0,
"vo_start": 0.6,
"vo_end": 13.48,
"text": "Kick had called the ban permanent. It lasted three months. On the ninth of January twenty twenty-five, his channel was simply back, with no clear explanation. By then, Saturday Night Live had already parodied the crash.",
"end": 13.755
},
{
"i": 2,
"start": 13.755,
"vo_start": 14.03,
"vo_end": 18.548,
"text": "Nine days later, he was streaming in the street when a stranger walked straight up and slapped him.",
"end": 18.823
},
{
"i": 3,
"start": 18.823,
"vo_start": 19.098,
"vo_end": 26.018,
"text": "According to Dexerto, Jack and his security chased the man down and beat him up. Kick banned him again. The same day.",
"end": 26.293
},
{
"i": 4,
"start": 26.293,
"vo_start": 26.568,
"vo_end": 37.528,
"text": "His version? He'd defended himself, and the one time he stood up for himself, he got banned. His appeal was rejected. Two hundred thousand followers, and nowhere to stream to them.",
"end": 37.803
},
{
"i": 5,
"start": 37.803,
"vo_start": 38.078,
"vo_end": 43.198,
"text": "So in February twenty twenty-six, he took the routine somewhere new. A golf tournament.",
"end": 44.148
}
],
