{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/tools/agent-kit/session-start.sh\" 2>/dev/null; exit 0",
            "timeout": 20
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/tools/agent-kit/rtk-rewrite.sh\" 2>/dev/null || exit 0",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
