{
"dur": 29.801,
"shots": [
{
"i": 1,
"start": 0.0,
"vo_start": 0.6,
"vo_end": 10.276,
"text": "In March 2021, one ship got stuck sideways in a ditch in the Egyptian desert. For six days, it blocked around ten billion dollars of world trade every single day.",
"end": 10.551
},
{
"i": 2,
"start": 10.551,
"vo_start": 10.826,
"vo_end": 17.146,
"text": "That ditch is the Suez Canal. It saves ships a trip of around eight thousand kilometres round Africa.",
"end": 17.421
},
{
"i": 3,
"start": 17.421,
"vo_start": 17.696,
"vo_end": 28.851,
"text": "Pharaohs tried to dig it. Persian kings, Greek kings, Roman emperors, caliphs, sultans and Napoleon all wanted it. It took three thousand years and one stubborn Frenchman to finish.",
"end": 29.801
}
],
