"vo_start": 0.6,
"vo_end": 8.72,
"text": "June 1812. Napoleon Bonaparte leads the biggest army Europe has ever seen, more than six hundred thousand men, across a river into Russia.",
"end": 8.995
},
{
"i": 2,
"start": 8.995,
"vo_start": 9.27,
"vo_end": 14.346,
"text": "Six months later, only a small fraction of them come back, through the snow, starving and frozen.",
"end": 14.621
},
{
"i": 3,
"start": 14.621,
"vo_start": 14.896,
"vo_end": 22.976,
"text": "He was the most powerful man in Europe. He had crowns, palaces and an empire. And every time he won, he wanted more.",
"end": 23.926
}
],
