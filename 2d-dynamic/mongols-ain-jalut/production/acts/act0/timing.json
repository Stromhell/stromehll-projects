{
"dur": 24.609,
"shots": [
{
"i": 1,
"start": 0.0,
"vo_start": 0.6,
"vo_end": 10.28,
"text": "By 1260, the Mongols had built the largest land empire the world had ever seen. China, Persia, Russia, Baghdad: every army that stood in their way had been destroyed.",
"end": 10.555
},
{
"i": 2,
"start": 10.555,
"vo_start": 10.83,
"vo_end": 16.52,
"text": "That summer, a Mongol embassy rode into Cairo with a letter for the sultan of Egypt: surrender, or be destroyed.",
"end": 16.795
},
{
"i": 3,
"start": 16.795,
"vo_start": 17.07,
"vo_end": 23.659,
"text": "The sultan had the envoys executed. A few weeks later, his army met the Mongols at a place called the Spring of Goliath.",
"end": 24.609
}
],
