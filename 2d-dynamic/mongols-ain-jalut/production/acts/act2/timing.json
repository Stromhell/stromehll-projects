{
"dur": 29.351,
"shots": [
{
"i": 1,
"start": 0.0,
"vo_start": 0.6,
"vo_end": 8.959,
"text": "Bukhara fell. Then Samarkand. Then Urgench, and Nishapur. Cities that refused to surrender were emptied.",
"end": 9.234
},
{
"i": 2,
"start": 9.234,
"vo_start": 9.509,
"vo_end": 14.349,
"text": "The shah ran west and died on a small island in the Caspian Sea, a hunted man.",
"end": 14.624
},
{
"i": 3,
"start": 14.624,
"vo_start": 14.899,
"vo_end": 20.459,
"text": "Genghis died in 1227, but his sons and grandsons kept going: China, Russia, Poland, Hungary.",
"end": 20.734
},
{
"i": 4,
"start": 20.734,
"vo_start": 21.009,
"vo_end": 28.401,
"text": "In 1253, the Great Khan M\u00f6ngke sent his brother Hulagu west with orders to bring Persia and the lands beyond under Mongol rule.",
"end": 29.351
}
],
